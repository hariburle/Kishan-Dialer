<?xml version="1.0" encoding="utf-8"?>
<!--
   Android Auto Backup rules:
   Preserves SharedPreferences (learned calling choices, card styles, preferences)
   and Room SQLite databases (ignored contacts, favorite contacts, automation rules, spam numbers)
   across app reinstalls and device updates.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
</full-backup-content>
