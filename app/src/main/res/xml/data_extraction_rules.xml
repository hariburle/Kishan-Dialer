<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ Data Extraction rules for Cloud Backup & Device Transfer:
   Preserves SharedPreferences and Room SQLite databases across reinstalls and device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
